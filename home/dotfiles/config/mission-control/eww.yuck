;; Keyboard-first command surface. Read-only EWW never accepts focus or
;; writes system state: Sway hotkeys dispatch explicit controller actions.
(defvar dark false)
(defvar view "home")
(defpoll network :interval "15s" :initial "{}" `python3 $HOME/.config/mission-control/widgets.py network`)
(defpoll audio :interval "3s" :initial "{}" `python3 $HOME/.config/mission-control/widgets.py audio`)
;; EWW_CONFIG_DIR is an expression variable, not exported to subprocesses.
(defpoll status :interval "15s" :initial "{}" `python3 $HOME/.config/mission-control/status.py`)
(defpoll gpu :interval "45s" :initial "GPU --" `python3 $HOME/.config/mission-control/status.py gpu`)
(defpoll workspaces :interval "3s" :initial "WS --" `python3 $HOME/.config/mission-control/status.py workspaces`)
(defpoll clock :interval "30s" `date '+%a %d %b · %H:%M'`)

(defwidget panel []
  (box :orientation "v" :space-evenly false :class {dark ? "panel dark" : "panel light"}
    (box :orientation "v" :class "header" :space-evenly false
      (label :xalign 0 :text "MISSION // CONTROL")
      (label :xalign 0 :class "sub" :text "SWAY · PROTOTYPE 01"))
    ;; Workspace context and navigation remain visible on every page.
    (label :xalign 0 :yalign 0 :class "workspace" :text workspaces)
    (label :xalign 0 :class "command-nav" :text "SUPER // [BS] STATUS  [N] NET  [M] AUDIO")
    (box :orientation "v" :visible {view == "home"} :class "readout" :space-evenly false
      (label :xalign 0 :class "section-title" :text "$ system.status")
      (box :orientation "v" :class "telemetry" :space-evenly false
        (label :xalign 0 :text {status.battery ?: "BAT --"})
        (label :xalign 0 :text {status.cpu ?: "CPU --"})
        (label :xalign 0 :text gpu)
        (label :xalign 0 :text {status.memory ?: "MEM --"})
        (label :xalign 0 :text {status.disk ?: "DISK --"})
        (label :xalign 0 :text {status.audio ?: "AUDIO --"})))
    (box :orientation "v" :visible {view == "network"} :class "readout" :space-evenly false
      (label :xalign 0 :class "section-title" :text "$ net.status")
      (label :xalign 0 :yalign 0 :class "console-text" :text {network.report ?: "RADIO   --"})
      (box :orientation "v" :class "commands" :space-evenly false
        (label :xalign 0 :class "section-title" :text "COMMANDS // SUPER + KEY")
        (label :xalign 0 :text "SHIFT+N  connect / edit [nmtui]")
        (label :xalign 0 :text "CTRL+N   radio on / off")
        (label :xalign 0 :class "sub" :text "Radio off disconnects Wi-Fi.")))
    (box :orientation "v" :visible {view == "audio"} :class "readout" :space-evenly false
      (label :xalign 0 :class "section-title" :text "$ audio.status")
      (label :xalign 0 :yalign 0 :class "console-text" :text {audio.report ?: "OUTPUT  --\nINPUT   --"})
      (box :orientation "v" :class "commands" :space-evenly false
        (label :xalign 0 :class "section-title" :text "COMMANDS // SUPER + KEY")
        (label :xalign 0 :text "[ / ]    output - / + 5%")
        (label :xalign 0 :text "SHIFT+M  output mute")
        (label :xalign 0 :text "CTRL+M   microphone mute")
        (label :xalign 0 :text "SHIFT+A  routing [GUI fallback]")
        (label :xalign 0 :class "sub" :text "Laptop media keys also work.")))
    (label :xalign 0 :class "hotkey-hint" :text "SUPER+F1 // ALL HOTKEYS")
    (label :xalign 0 :class "clock" :text clock)))

(defwindow compact
  :monitor 0 :geometry (geometry :width "480px" :height "100%" :anchor "right center")
  :stacking "fg" :exclusive true :focusable false (panel))
(defwindow expanded
  :monitor 0 :geometry (geometry :width "720px" :height "100%" :anchor "right center")
  :stacking "fg" :exclusive true :focusable false (panel))
